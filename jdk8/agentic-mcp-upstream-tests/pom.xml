<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.langchain4j.jdk8</groupId>
        <artifactId>langchain4j-jdk8-parent</artifactId>
        <version>1.23.0-jdk8-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>langchain4j-jdk8-agentic-mcp-upstream-tests</artifactId>
    <dependencies>
        <dependency>
            <groupId>dev.langchain4j.jdk8</groupId>
            <artifactId>langchain4j-agentic-mcp</artifactId>
            <version>1.23.0-jdk8-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.3</version>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.14.2</version>
        </dependency>
    </dependencies>
    <build>
        <testSourceDirectory>${project.basedir}/../..</testSourceDirectory>
        <testResources>
            <testResource>
                <directory>${project.basedir}/../../langchain4j-agentic/src/test/resources</directory>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <testRelease>17</testRelease>
                    <parameters>true</parameters>
                    <testIncludes combine.self="override">
                        <testInclude>langchain4j-agentic-mcp/src/test/java/dev/langchain4j/agentic/mcp/McpAgentTest.java</testInclude>
                        <testInclude>langchain4j-agentic-mcp/src/test/java/dev/langchain4j/agentic/mcp/McpActivationConditionTest.java</testInclude>
                    </testIncludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes combine.self="override">
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>