<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.langchain4j.jdk8</groupId>
        <artifactId>langchain4j-jdk8-parent</artifactId>
        <version>1.23.0-jdk8-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>langchain4j-jdk8-upstream-tests</artifactId>
    <dependencies>
        <dependency>
            <groupId>dev.langchain4j.jdk8</groupId>
            <artifactId>langchain4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.3</version>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j.jdk8</groupId>
            <artifactId>langchain4j-http-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.14.2</version>
        </dependency>
    </dependencies>
    <build>
        <testSourceDirectory>${project.basedir}/../..</testSourceDirectory>
        <testResources>
            <testResource>
                <directory>${project.basedir}/../../langchain4j-core/src/test/resources</directory>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <testRelease>17</testRelease>
                    <testIncludes combine.self="override">
                        <testInclude>langchain4j-core/src/test/java/dev/langchain4j/internal/ValidationUtilsTest.java</testInclude>
                        <testInclude>langchain4j-core/src/test/java/dev/langchain4j/internal/UtilsTest.java</testInclude>
                        <testInclude>langchain4j-core/src/test/java/dev/langchain4j/data/document/MetadataTest.java</testInclude>
                        <testInclude>langchain4j-core/src/test/java/dev/langchain4j/data/message/AiMessageTest.java</testInclude>
                        <testInclude>langchain4j-core/src/test/java/dev/langchain4j/agent/tool/ToolExecutionRequestTest.java</testInclude>
                        <testInclude>langchain4j-core/src/test/java/dev/langchain4j/internal/JsonParsingUtilsTest.java</testInclude>
                        <testInclude>langchain4j-core/src/test/java/dev/langchain4j/internal/JsonSchemaElementUtilsTest.java</testInclude>
                        <testInclude>langchain4j-core/src/test/java/dev/langchain4j/model/batch/BatchItemResultTest.java</testInclude>
                        <testInclude>langchain4j-core/src/test/java/dev/langchain4j/model/decision/response/DecisionResponseTest.java</testInclude>
                        <testInclude>langchain4j-http-client/src/test/java/dev/langchain4j/http/client/sse/DefaultServerSentEventParserTest.java</testInclude>
                    </testIncludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes combine.self="override">
                        <include>**/ValidationUtilsTest.java</include>
                        <include>**/UtilsTest.java</include>
                        <include>**/MetadataTest.java</include>
                        <include>**/AiMessageTest.java</include>
                        <include>**/ToolExecutionRequestTest.java</include>
                        <include>**/JsonParsingUtilsTest.java</include>
                        <include>**/JsonSchemaElementUtilsTest.java</include>
                        <include>**/BatchItemResultTest.java</include>
                        <include>**/DecisionResponseTest.java</include>
                        <include>**/DefaultServerSentEventParserTest.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>