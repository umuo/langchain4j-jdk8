<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.langchain4j.jdk8</groupId>
        <artifactId>langchain4j-jdk8-parent</artifactId>
        <version>1.23.0-jdk8-SNAPSHOT</version>
        <relativePath>../jdk8/pom.xml</relativePath>
    </parent>
    <artifactId>langchain4j-agentic-mcp</artifactId>
    <name>LangChain4j :: Agentic MCP Integration (Java 8 WIP)</name>
    <dependencies>
        <dependency><groupId>dev.langchain4j.jdk8</groupId><artifactId>langchain4j-mcp</artifactId><version>1.23.0-jdk8-SNAPSHOT</version></dependency>
        <dependency>
            <groupId>dev.langchain4j.jdk8</groupId><artifactId>langchain4j-agentic</artifactId>
            <version>1.23.0-jdk8-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>junit</groupId><artifactId>junit</artifactId><version>4.13.2</version><scope>test</scope>
        </dependency>
    </dependencies>
    <build><testSourceDirectory>${project.basedir}/..</testSourceDirectory><plugins>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
            <configuration><testRelease>8</testRelease><testIncludes combine.self="override">
            <testInclude>langchain4j-agentic-mcp/src/test/java/**/*Jdk8Test.java</testInclude>
            <testInclude>jdk8/agentic-mcp-example/src/main/java/example/AgenticMcpFixture.java</testInclude>
        </testIncludes></configuration></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId>
            <configuration><jvm>${java8.home}/bin/java</jvm></configuration></plugin>
    </plugins></build>
</project>
